From 2b7300816e152051ec63c5fe30c8f2bee5f89470 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Tue, 13 Oct 2026 21:43:08 -0600
Subject: [PATCH 02/11] gpu: add a switch to turn host rendering off (sync-only
 command processor)

A renderer that draws the guest's frames from another source than the
command buffer (NativeXRenderer, which hooks the game's XDK Direct3D library)
still needs the command processor for everything the game waits on:
fences, interrupts, swaps, event writes. It does not need the host draws,
which would only cost GPU time and present a frame nobody sees.

IGraphicsSystem::SetHostRendering(enabled) turns host rendering off (and
on again; it may be called at any time, for A/B comparisons). Off, the
command processor executes every packet as before, but:
- draws are not issued on the host, which also skips clears and resolves
  (resolves are copy-mode draws on Xenos);
- occlusion queries take the generic path that reports the fake sample
  count (query_occlusion_fake_sample_count), since no host draw counts
  samples.

The draw observer still sees every draw packet, with issued = false.
kGpuPluginAbiVersion is bumped for the new virtual function.

This patch is only for projects that use NativeXRenderer; it is kept in
native_x_renderer/sdk_patches/ and applied after the shared series.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 1ab386ac256a505659f75cac8aa39ed513b3749e)
(cherry picked from commit ac4e8afa0ab56e45a59c2cb8137094e10892ba5e)
---
 include/rex/graphics/command_processor.h  |  6 ++++++
 include/rex/graphics/graphics_system.h    |  1 +
 include/rex/system/gpu_plugin.h           |  2 +-
 include/rex/system/interfaces/graphics.h  | 10 ++++++++++
 src/graphics/command_processor.cpp        |  2 +-
 src/graphics/d3d12/command_processor.cpp  |  3 ++-
 src/graphics/graphics_system.cpp          |  9 +++++++++
 src/graphics/vulkan/command_processor.cpp |  3 ++-
 8 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index c6a80bd..7a1ee19 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -94,6 +94,10 @@ class CommandProcessor {
   // See system::IGraphicsSystem::SetDrawObserver.
   void SetDrawObserver(system::GpuDrawObserver observer, void* user);
 
+  // See system::IGraphicsSystem::SetHostRendering.
+  void SetHostRendering(bool enabled) { host_rendering_.store(enabled, std::memory_order_relaxed); }
+  bool host_rendering() const { return host_rendering_.load(std::memory_order_relaxed); }
+
   virtual bool Initialize();
   virtual void Shutdown();
 
@@ -273,6 +277,8 @@ class CommandProcessor {
   // Draw observer (SetDrawObserver), and the physical address of the type-3 packet being executed,
   // kept only while an observer is set.
   std::atomic<system::GpuDrawObserver> draw_observer_{nullptr};
+  // Off: packets run for synchronization only (SetHostRendering).
+  std::atomic<bool> host_rendering_{true};
   void* draw_observer_user_ = nullptr;
   uint32_t observed_packet_address_ = 0;
 
diff --git a/include/rex/graphics/graphics_system.h b/include/rex/graphics/graphics_system.h
index 3913c49..ae5ec2c 100644
--- a/include/rex/graphics/graphics_system.h
+++ b/include/rex/graphics/graphics_system.h
@@ -76,6 +76,7 @@ class GraphicsSystem : public system::IGraphicsSystem {
 
   void SetInterruptCallback(uint32_t callback, uint32_t user_data) override;
   bool SetDrawObserver(system::GpuDrawObserver observer, void* user) override;
+  bool SetHostRendering(bool enabled) override;
   void DispatchInterruptCallback(uint32_t source, uint32_t cpu);
 
   virtual void ClearCaches();
diff --git a/include/rex/system/gpu_plugin.h b/include/rex/system/gpu_plugin.h
index b910179..981e32f 100644
--- a/include/rex/system/gpu_plugin.h
+++ b/include/rex/system/gpu_plugin.h
@@ -29,7 +29,7 @@
 namespace rex::system {
 
 // Bump on any change to GpuCreateInfo or to the IGraphicsSystem interface.
-inline constexpr uint32_t kGpuPluginAbiVersion = 2;
+inline constexpr uint32_t kGpuPluginAbiVersion = 3;
 
 inline constexpr const char* kGpuCreateSymbol = "rex_gpu_create";
 inline constexpr const char* kGpuAbiVersionSymbol = "rex_gpu_abi_version";
diff --git a/include/rex/system/interfaces/graphics.h b/include/rex/system/interfaces/graphics.h
index 162fde9..1e6c2ff 100644
--- a/include/rex/system/interfaces/graphics.h
+++ b/include/rex/system/interfaces/graphics.h
@@ -101,6 +101,16 @@ class IGraphicsSystem {
     return false;
   }
 
+  // Host rendering on or off. Off, the command processor still executes every packet (registers,
+  // fences, interrupts, swaps, event writes) but draws nothing on the host: draws, clears and resolves
+  // are skipped, and occlusion queries report the fake sample count. For a renderer that draws the
+  // guest's frames itself from another source (NativeXRenderer). On by default; may be changed at any
+  // time. Returns false if the system has no command processor.
+  virtual bool SetHostRendering(bool enabled) {
+    (void)enabled;
+    return false;
+  }
+
   // Persistent shader/pipeline storage under the cache root. Default: none.
   virtual void InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id,
                                        bool blocking) {
