From a91fb7a98b57aaee91602d00d3ea2ff8b85c061f Mon Sep 17 00:00:00 2001
From: Gandalf4212 <gandalf4212@gmail.com>
Date: Tue, 10 Nov 2026 22:14:53 -0500
Subject: [PATCH] D154 (test): F7 invalidates the guest memory mirror once

After Burner Climax (session 4): the stage 2/3 terrain's draws produce no
pixels even with depth, cull, alpha test and blend off (D153, log 037),
while its vertex data in guest memory is right and lands on screen (D152).
If the mirror holds a stale copy of that memory, F7 makes the draws copy
it again.
---
 src/draw.cpp     | 12 ++++++++++++
 src/draw.h       |  3 +++
 src/renderer.cpp |  4 ++++
 3 files changed, 19 insertions(+)

diff --git a/src/draw.cpp b/src/draw.cpp
index 9664bcf..b778ac2 100644
--- a/src/draw.cpp
+++ b/src/draw.cpp
@@ -820,6 +820,12 @@ std::atomic<bool> g_draw_dump_requested{false};
 
 void DrawPath::RequestDrawDump() { g_draw_dump_requested.store(true); }
 
+namespace {
+std::atomic<bool> g_mirror_invalidation_requested{false};
+}  // namespace
+
+void DrawPath::RequestMirrorInvalidation() { g_mirror_invalidation_requested.store(true); }
+
 // D152: the readback of a draw whose vertex shader is listed in native_x_renderer_inspect_vs (F8 dump frames).
 void DrawPath::InspectDraw(const rg::SpirvShader& vertex_shader) {
   const std::string& wanted = REXCVAR_GET(native_x_renderer_inspect_vs);
@@ -1950,6 +1956,12 @@ void DrawPath::FillSystemConstants(const DrawContext& draw) {
 uint32_t DrawPath::TakePackedRead() { return textures_->TakePackedRead(); }
 
 void DrawPath::EndFrame() {
+  // D154 (test): F7.
+  if (g_mirror_invalidation_requested.exchange(false) && memory_) {
+    memory_->InvalidateAllPages();
+    REXLOG_INFO("[native_x_renderer] D154: the guest memory mirror invalidated (F7): every range read from now on is "
+                "copied again");
+  }
   // D149: the draw dump covers the frame after the request.
   if (dump_frames_ > 0 && --dump_frames_ == 0) {
     REXLOG_INFO("[native_x_renderer] D149: draw dump end, {} draws", dump_index_);
diff --git a/src/draw.h b/src/draw.h
index f50bd31..ffe0538 100644
--- a/src/draw.h
+++ b/src/draw.h
@@ -111,6 +111,9 @@ class DrawPath {
   void EndFrame();
   // D149: the next frame's draws are logged as the renderer drew them (F8, bind_native_x_renderer_draw_dump).
   static void RequestDrawDump();
+  // D154 (test): the guest memory mirror invalidated at the next frame's end (F7), so that every range the draws
+  // read is copied from guest memory again.
+  static void RequestMirrorInvalidation();
   // Something else bound render targets (a clear, a resolve, Present): the next draw binds its own again, sets
   // its viewport and scissor again (DiligentCore resets the viewport with the render targets, D81), and commits
   // its shader resources again (D82: the other work committed its own, or submitted the command buffer).
diff --git a/src/renderer.cpp b/src/renderer.cpp
index d824148..461bc89 100644
--- a/src/renderer.cpp
+++ b/src/renderer.cpp
@@ -601,6 +601,10 @@ bool EnsureDrawPath() {
   // D149: F8 logs the next frame's draws as the renderer drew them (targets, viewport, depth, cull, shaders).
   rex::ui::RegisterBind("bind_native_x_renderer_draw_dump", "F8",
                         "NativeXRenderer: log the next frame's draws as drawn", [] { DrawPath::RequestDrawDump(); });
+  // D154 (test): F7 invalidates the guest memory mirror once (stale vertex data?).
+  rex::ui::RegisterBind("bind_native_x_renderer_invalidate_memory", "F7",
+                        "NativeXRenderer: copy all guest memory the draws read again",
+                        [] { DrawPath::RequestMirrorInvalidation(); });
   g_draw->SetUploadAhead(UploadAhead);
   g_draw->SetSceneWaitBudget(std::max(0.0, REXCVAR_GET(native_x_renderer_scene_wait_ms)));
   g_draw->SetTextureSizeConstants(g_profile->texture_size_constants, g_profile->texture_size_constant_count);
