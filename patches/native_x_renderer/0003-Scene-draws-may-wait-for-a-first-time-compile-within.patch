From f588781ec5977efe8b67029506e0f4c61e4de503 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 14:06:16 -0500
Subject: [PATCH 3/6] Scene draws may wait for a first-time compile, within a
 budget per frame (D116)

---
 docs/decisions.md | 16 ++++++++++++++++
 src/draw.cpp      | 19 ++++++++++++++++---
 src/draw.h        | 10 ++++++++++
 src/renderer.cpp  | 16 +++++++++++++---
 4 files changed, 55 insertions(+), 6 deletions(-)

diff --git a/docs/decisions.md b/docs/decisions.md
index 9612261..75327fd 100644
--- a/docs/decisions.md
+++ b/docs/decisions.md
@@ -4363,3 +4363,19 @@ play; it now copies pointers only. A burst of new translations in play boosts th
 so the shipped microcode cannot be translated ahead; their variants are kept as the game uses them. The pixel
 translations are guesses (no MSAA centroids, no PsParamGen); what draws ask that was not guessed is translated as
 before and kept.
+
+## D116 — Scene draws may wait for a first-time compile, within a budget per frame (2026-11-07, Mad Riders)
+
+**Decision:** `native_x_renderer_scene_wait_ms` (default 0, as before): the draws that D101 does not make wait (the
+scene's) also wait for their shaders' translation and their pipeline, as long as the frame's total wait stays within
+that many milliseconds; past it they are skipped (D28, D34) until the compile is done. The offscreen waits of D101
+are unchanged (and not counted). The log's line counts the scene draws that waited and how long.
+
+**Why:** Mad Riders, first run with the shader cache (D115) prepared: what is left to compile while racing is the
+vertex shaders' variants for each vertex layout (the game's D3D patches their fetches, so they cannot be compiled
+ahead) and their pipelines, about 70-130 skipped draws per 10 s on a first lap: objects blinking out and back. The
+offscreen draws that already wait took 5.6 ms on average: most compiles fit a few milliseconds of a frame. Waiting
+without a budget (D101 on every draw) made each new pipeline a visible stall (Mad Riders, 2026-11-03).
+
+**Revisit if:** a game's compiles are mostly longer than a frame: the budget then only delays the frame without
+saving the draw.
diff --git a/src/draw.cpp b/src/draw.cpp
index fe9fde1..9090c23 100644
--- a/src/draw.cpp
+++ b/src/draw.cpp
@@ -924,7 +924,15 @@ bool DrawPath::DrawInternal(const StateTracker::Program& vertex_program, const S
   // D101: a draw into an offscreen target waits for its translations (the workers finish them on their own).
   const auto wait_start = std::chrono::steady_clock::now();
   bool waited = false;
-  while (translating && wait_for_pipelines_ && std::chrono::steady_clock::now() - wait_start < kPipelineWaitLimit) {
+  // D116: the other draws wait too, within what is left of the frame's budget (short compiles do not show).
+  auto may_wait = [&] {
+    auto elapsed = std::chrono::steady_clock::now() - wait_start;
+    if (elapsed >= kPipelineWaitLimit) return false;
+    if (wait_for_pipelines_) return true;
+    if (steady_pass_) return false;  // D126: skipped, not waited for
+    return std::chrono::duration<double, std::milli>(elapsed).count() < scene_wait_left_ms_;
+  };
+  while (translating && may_wait()) {
     waited = true;
     std::this_thread::sleep_for(std::chrono::microseconds(200));
     translating = false;
@@ -1117,13 +1125,17 @@ bool DrawPath::DrawInternal(const StateTracker::Program& vertex_program, const S
     return false;
   }
   // D101: a draw into an offscreen target waits for its pipeline (DiligentCore's threads compile it).
-  while (wait_for_pipelines_ && !pipeline->failed && !pipelines_->Ready(*pipeline) &&
-         std::chrono::steady_clock::now() - wait_start < kPipelineWaitLimit) {
+  while (!pipeline->failed && !pipelines_->Ready(*pipeline) && may_wait()) {
     waited = true;
     std::this_thread::sleep_for(std::chrono::microseconds(200));
   }
   if (waited) {
     double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - wait_start).count();
+    if (!wait_for_pipelines_) {
+      scene_wait_left_ms_ = std::max(0.0, scene_wait_left_ms_ - ms);
+      ++stats_.scene_waited;
+      stats_.scene_waited_ms += ms;
+    }
     ++stats_.waited;
     stats_.waited_ms += ms;
     stats_.max_waited_ms = std::max(stats_.max_waited_ms, ms);
@@ -1786,6 +1798,7 @@ void DrawPath::EndFrame() {
   // cache saved, on a thread of its own (D45), once nothing new was compiled for 10 s (at 60 FPS), and at
   // most every 5 minutes (D52): new areas bring pipelines every few seconds, and each save writes tens of
   // MB. What is not saved yet is in the records, compiled again at the next start.
+  scene_wait_left_ms_ = scene_wait_budget_ms_;  // D116
   if (storage_) storage_->Flush();
   // A burst of new translations in play (a new area, D115): every core but one on them until it is through, so
   // their draws are skipped for fewer frames.
diff --git a/src/draw.h b/src/draw.h
index dbaebc0..8c7ce66 100644
--- a/src/draw.h
+++ b/src/draw.h
@@ -170,6 +170,12 @@ class DrawPath {
     wait_for_pipelines_ = on;
     steady_pass_ = steady_pass;
   }
+  // D116: the other draws wait for their shaders and pipeline too, up to this many milliseconds per frame in all
+  // (then they are skipped, D28/D34): a compile that finishes within it does not show. 0: skipped at once.
+  void SetSceneWaitBudget(double ms) {
+    scene_wait_budget_ms_ = ms;
+    scene_wait_left_ms_ = ms;
+  }
   // The float constants that hold a texture's size (Profile::texture_size_constants, D93).
   void SetTextureSizeConstants(const Profile::TextureSizeConstant* constants, uint32_t count) {
     texture_size_constants_ = std::span(constants, count);
@@ -187,6 +193,9 @@ class DrawPath {
     uint32_t waited = 0;
     double waited_ms = 0.0, max_waited_ms = 0.0;
     uint32_t steady_skipped = 0;  // D126: draws of passes drawn frame after frame skipped instead of waiting
+    // Of them, the scene's draws that waited within the frame's budget (D116), and how long in all.
+    uint32_t scene_waited = 0;
+    double scene_waited_ms = 0.0;
     // Texture bindings: resolved, guest, placeholders, and placeholders for the other dimension's binding.
     uint32_t textures_resolved = 0, textures_guest = 0, textures_placeholder = 0, textures_other_dimension = 0;
     uint32_t copies = 0;  // buffer copies (guest memory pages, converted indices)
@@ -254,6 +263,7 @@ class DrawPath {
   bool aspect_box_ = false;  // D43
   bool wait_for_pipelines_ = false;  // D101
   bool steady_pass_ = false;         // D126
+  double scene_wait_budget_ms_ = 0.0, scene_wait_left_ms_ = 0.0;  // D116
   bool jitter_on_ = false;   // D47
   float jitter_[2] = {};
   uint32_t jitter_size_[2] = {};
diff --git a/src/renderer.cpp b/src/renderer.cpp
index 32bf0cc..6550868 100644
--- a/src/renderer.cpp
+++ b/src/renderer.cpp
@@ -96,6 +96,10 @@ REXCVAR_DEFINE_BOOL(native_x_renderer_skip_steady_passes, true, "NativeXRenderer
                     "A pass the game draws frame after frame does not wait for its pipelines as other offscreen draws "
                     "do: skipped until they are ready, it mends itself, and a slow pipeline does not stop the game "
                     "(D126); false: every offscreen draw waits");
+REXCVAR_DEFINE_DOUBLE(native_x_renderer_scene_wait_ms, 0.0, "NativeXRenderer",
+                      "The milliseconds per frame the other draws may wait, in all, for a shader or pipeline compiled "
+                      "for the first time, before they are skipped (D116): compiles that finish within it do not show "
+                      "as objects popping in. 0: skipped at once (no stutter)");
 REXCVAR_DEFINE_BOOL(native_x_renderer_fill_screen, true, "NativeXRenderer",
                     "Fill an output that is not 16:9, with a render scale per axis, when the game's hooks widen its "
                     "cameras (read at startup); false: the 16:9 image with bars");
@@ -390,6 +394,8 @@ struct Creation {
   uint64_t waited_draws = 0;
   double waited_ms = 0.0, max_waited_ms = 0.0;
   uint32_t steady_skipped = 0;  // D126
+  uint64_t scene_waited_draws = 0;  // of them, scene draws within the frame's budget (D116)
+  double scene_waited_ms = 0.0;
 } g_creation;
 
 // Buffer copies (each ends the render pass) and guest memory uploads per frame, since the last log line.
@@ -592,6 +598,7 @@ bool EnsureDrawPath() {
   }
   g_draw = std::move(draw);
   g_draw->SetUploadAhead(UploadAhead);
+  g_draw->SetSceneWaitBudget(std::max(0.0, REXCVAR_GET(native_x_renderer_scene_wait_ms)));
   g_draw->SetTextureSizeConstants(g_profile->texture_size_constants, g_profile->texture_size_constant_count);
   return true;
 }
@@ -2037,6 +2044,8 @@ void ExecuteFrameEnd(const Command& c) {
   g_creation.compiling_draws += draws.compiling;
   g_creation.waited_draws += draws.waited;
   g_creation.steady_skipped += draws.steady_skipped;
+  g_creation.scene_waited_draws += draws.scene_waited;
+  g_creation.scene_waited_ms += draws.scene_waited_ms;
   g_creation.waited_ms += draws.waited_ms;
   g_creation.max_waited_ms = std::max(g_creation.max_waited_ms, draws.max_waited_ms);
   ++g_uploads.frames;
@@ -2171,13 +2180,14 @@ void ExecuteFrameEnd(const Command& c) {
     REXLOG_INFO("[native_x_renderer] renderer: frame {}: created on the render thread: {} shader analyses ({:.1f} ms, "
                 "max {:.1f}), {} pipelines ({:.1f} ms, max {:.1f}); on worker threads: {} translations ({:.1f} ms, "
                 "max {:.1f}); draws skipped: {} while a shader was translated, {} while their pipeline compiled; "
-                "offscreen draws that waited for theirs (D101): {} ({:.1f} ms, max {:.1f}), of steady passes that "
-                "did not (D126): {}",
+                "draws that waited for theirs: {} ({:.1f} ms, max {:.1f}), of them {} scene draws within the frame's "
+                "budget (D116, {:.1f} ms), of steady passes that did not (D126): {}",
                 frame, g_creation.analyses.count, g_creation.analyses.ms, g_creation.analyses.max_ms,
                 g_creation.pipelines.count, g_creation.pipelines.ms, g_creation.pipelines.max_ms,
                 g_creation.translations.count, g_creation.translations.ms, g_creation.translations.max_ms,
                 g_creation.translating_draws, g_creation.compiling_draws, g_creation.waited_draws,
-                g_creation.waited_ms, g_creation.max_waited_ms, g_creation.steady_skipped);
+                g_creation.waited_ms, g_creation.max_waited_ms, g_creation.scene_waited_draws,
+                g_creation.scene_waited_ms, g_creation.steady_skipped);
     g_creation = {};
     if (g_queries_on) {
       OcclusionQueries::Stats q = g_queries.TakeStats();
