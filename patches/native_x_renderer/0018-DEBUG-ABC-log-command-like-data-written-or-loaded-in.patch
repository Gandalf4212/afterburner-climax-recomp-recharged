From ee949251decbbfc3e06d1cb4afdbd50cea297cd1 Mon Sep 17 00:00:00 2001
From: Gandalf4212 <gandalf4212@gmail.com>
Date: Mon, 9 Nov 2026 21:38:39 -0500
Subject: [PATCH] DEBUG(ABC): log command-like data written or loaded into
 constants, and programs that look like command data (remove for the final
 build)

---
 src/state.cpp | 47 +++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/src/state.cpp b/src/state.cpp
index 4efe0d8..6f23067 100644
--- a/src/state.cpp
+++ b/src/state.cpp
@@ -104,11 +104,47 @@ bool SkippedConstants(bool skip_constants, uint32_t reg, uint32_t count) {
 
 // `copy_microcode`: a shader load's microcode is copied (a scan when a segment ends: the library may reuse its
 // memory before the call returns); otherwise it is read where it is, before the call returns (D72).
+// DEBUG(ABC) begin: log constant writes and loads whose values look like PM4 type-3 headers (command data read as
+// constants, log 017). Remove for the final build.
+thread_local const char* g_debug_call = "?";
+std::unordered_set<uint32_t> g_debug_packets;
+bool DebugPacketLike(uint32_t v) { return (v & 0xC00000FEu) == 0xC0000000u && ((v >> 8) & 0x7F) != 0; }
+void DebugCheck(const uint8_t* base, const PacketScan& out, size_t w0, size_t l0, uint32_t packet, uint32_t header,
+                int depth) {
+  auto check = [&](const std::vector<std::pair<uint32_t, uint32_t>>& v, size_t from, const char* kind) {
+    for (size_t i = from; i < v.size(); ++i) {
+      if (v[i].first < 0x4000 || v[i].first >= 0x4800 || !DebugPacketLike(v[i].second)) continue;
+      if (g_debug_packets.size() >= 60 || !g_debug_packets.insert(packet).second) return;
+      uint32_t source = (kind[0] == 'l' && ((header >> 8) & 0x7F) == 0x2F) ? Load32(base, packet + 4) : 0;
+      REXLOG_INFO("[native_x_renderer] DEBUG(ABC) {} of command-like data into constants: call {}, packet {:08X} "
+                  "header {:08X} (type {} opcode {:02X}{}), depth {}, register {:04X} (vec4 {}) = {:08X}, {} values "
+                  "from this packet; load source {:08X}; next dwords {:08X} {:08X} {:08X}",
+                  kind, g_debug_call, packet, header, header >> 30, (header >> 8) & 0x7F,
+                  (header & 1) ? ", predicated" : "", depth, v[i].first, (v[i].first - 0x4000) / 4, v[i].second,
+                  v.size() - from, source, Load32(base, packet + 4), Load32(base, packet + 8),
+                  Load32(base, packet + 12));
+      return;
+    }
+  };
+  check(out.writes, w0, "write");
+  check(out.loads, l0, "load");
+}
+// DEBUG(ABC) end
+
 void ScanPackets(const uint8_t* base, uint32_t begin, uint32_t end, PacketScan& out, int depth,
                  bool skip_constants, bool copy_microcode) {
   uint32_t p = begin;
   while (p + 4 <= end) {
     uint32_t header = Load32(base, p);
+    // DEBUG(ABC): the packet's start and what it added, checked after it (DebugCheck).
+    const uint32_t debug_packet = p;
+    const size_t debug_w = out.writes.size(), debug_l = out.loads.size();
+    struct DebugAfter {
+      const uint8_t* base; const PacketScan& out; size_t w, l; uint32_t packet, header; int depth;
+      ~DebugAfter() {
+        if (header && !((header >> 30) == 3 && ((header >> 8) & 0x7F) == 0x3F)) DebugCheck(base, out, w, l, packet, header, depth);
+      }
+    } debug_after{base, out, debug_w, debug_l, debug_packet, header, depth};
     p += 4;
     if (!header) continue;
     switch (header >> 30) {
@@ -367,6 +403,7 @@ void StateTracker::Enter(Call call, uint32_t device, const uint8_t* base, bool n
       if (inside_segment_change) return;
       uint32_t segment_end = Load32(base, outer.device + d.command_buffer_write) + 4;
       if (segment_end >= outer.scan_from && segment_end - outer.scan_from < 0x400000) {
+        g_debug_call = "segment change";  // DEBUG(ABC)
         ScanPackets(base, outer.scan_from, segment_end, scan_, 0, outer.draw, true);
         outer.scan_from = segment_end;
       } else {
@@ -451,6 +488,7 @@ const TrackedCall* StateTracker::TakeFilledPackets(const uint8_t* base) {
   const Pending& p = filled_.p;
   uint32_t end = filled_.end;
   scan_.Clear();
+  g_debug_call = Info(filled_.call).name;  // DEBUG(ABC)
   if (end >= p.scan_from && end - p.scan_from < 0x400000) {
     ScanPackets(base, p.scan_from, end, scan_, 0, false, false);
   } else {
@@ -504,6 +542,7 @@ const TrackedCall* StateTracker::Leave(Call call, const uint8_t* base, bool nest
   // A setter that only wrote the shadow (D72): nothing to read or apply. One that moved to another segment wrote
   // packets (begin != scan_from).
   if (skip_empty_calls_ && !draw && end == p.begin && p.scan_from == p.begin && initialized_) return nullptr;
+  g_debug_call = Info(call).name;  // DEBUG(ABC)
   if (end >= p.scan_from && end - p.scan_from < 0x400000) {
     ScanPackets(base, p.scan_from, end, scan_, 0, draw, false);
   } else {
@@ -715,6 +754,14 @@ void StateTracker::Gather(const Pending& p, Call call, bool draw, const uint8_t*
       program->loaded_by = call;
       program->packet = load.packet;
       program->immediate = load.immediate;
+      // DEBUG(ABC): a new program whose first dword looks like a PM4 header (not microcode).
+      if (load.dwords && DebugPacketLike(ucode[0]) && g_program_logs.fetch_add(1, std::memory_order_relaxed) < 200) {
+        REXLOG_INFO("[native_x_renderer] DEBUG(ABC) new {} program {:016X} looks like command data: call {}, packet "
+                    "{:08X} {} address {:08X}, {} dwords, depth {}, first {:08X} {:08X} {:08X} {:08X}",
+                    load.type ? "pixel" : "vertex", hash, Info(call).name, load.packet,
+                    load.immediate ? "IM_LOAD_IMMEDIATE" : "IM_LOAD", load.address, load.dwords, load.depth, ucode[0],
+                    load.dwords > 1 ? ucode[1] : 0, load.dwords > 2 ? ucode[2] : 0, load.dwords > 3 ? ucode[3] : 0);
+      }
       if (load.depth && g_program_logs.fetch_add(1, std::memory_order_relaxed) < 200) {
         // D136: a new program from an indirect buffer: its hash matches a failed translation's.
         REXLOG_INFO("[native_x_renderer] D136: new {} program {:016X} from an indirect buffer (depth {}), call {}: "
-- 
