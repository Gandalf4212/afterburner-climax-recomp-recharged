From 6c8d207e6e9dbeee6a5f5e25434fa674c1013ded Mon Sep 17 00:00:00 2001
From: Gandalf4212 <gandalf4212@gmail.com>
Date: Sun, 8 Nov 2026 09:54:39 -0500
Subject: [PATCH 1/6] scene-size-and-scene-antialiasing

---
 include/native_x_renderer/native_x_renderer.h | 10 ++++++
 src/renderer.cpp                              | 36 ++++++++++++++++---
 2 files changed, 41 insertions(+), 5 deletions(-)

diff --git a/include/native_x_renderer/native_x_renderer.h b/include/native_x_renderer/native_x_renderer.h
index 0cfd08b..efcb624 100644
--- a/include/native_x_renderer/native_x_renderer.h
+++ b/include/native_x_renderer/native_x_renderer.h
@@ -139,6 +139,10 @@ struct Profile {
   ObjectLayout objects;
   // The game's output resolution (its front buffer): the image the render scale fits to the screen.
   uint32_t output_width = 1280, output_height = 720;
+  // The size of the target the game draws its scene into, when it is not the output's (Mad Riders: 1280x672 for a
+  // 1280x720 output). Draws into it are scene draws for D101 (skipped while their pipeline is created, not waited
+  // for). 0: the output's size.
+  uint32_t scene_width = 0, scene_height = 0;
   // The return address of the Resolve call that copies the finished scene: after the game's
   // post-processing, before its HUD is composited. NativeXRenderer's antialiasing (FXAA or SMAA) is applied to
   // that copy, a texture of the game's output size (resolves from the same caller to other sizes are not
@@ -173,6 +177,12 @@ struct Profile {
   // their motion is drawn, where the vertices do not show the movement (GH Metallica's board stands still while its
   // texture scrolls): the game sets their last positions. nullptr: none.
   void (*overlay_motion_adjust)(OverlayDraw* draws, size_t count) = nullptr;
+  // The finished scene is copied into a texture of the profile's scene size (scene_width/height), not of the output's,
+  // and drawn into the output's target before the HUD (Mad Riders: the scene and its post-processing at 1280x672,
+  // composited into the 1280x720 frame; every resolve goes through one engine function). The antialiasing is then
+  // applied to the newest such copy from scene_resolve_caller when the first draw into a target of the output's size
+  // comes, instead of at a resolve of the output's size. False: as D41.
+  bool scene_resolve_before_output = false;
   // The game's hooks widen its 16:9 cameras by AspectFactor() (D43): NativeXRenderer then fills an output of any
   // aspect ratio, with a separate render scale per axis, instead of showing the 16:9 image with bars.
   bool widens_cameras = false;
diff --git a/src/renderer.cpp b/src/renderer.cpp
index 49be032..2972f65 100644
--- a/src/renderer.cpp
+++ b/src/renderer.cpp
@@ -162,6 +162,9 @@ DisplayGamma g_gamma;  // the guest's display gamma ramp, applied when presentin
 Scaling g_scaling;     // the image scaled into the window by FSR 1 or NIS, and sharpened (D115)
 Antialiasing g_aa;     // on the finished scene (D41)
 bool g_scene_antialiased = false;  // this frame's scene copy antialiased already (Profile::scene_resolve_once, D94)
+// Profile::scene_resolve_before_output: the newest scene-size copy from the scene's caller, antialiased when the frame
+// first draws into a target of the output's size (0: none pending).
+uint32_t g_pending_scene_copy = 0;
 Upscaler g_upscaler;   // NVIDIA DLSS (Phase 5, D46)
 // Frame generation (D123): AMD's, and whether it is on; this frame's view inputs, taken at its end and prepared at
 // Present, after the 2D layer's motion (D124) is drawn over them; whether the view ended this frame; the 2D layer's
@@ -583,6 +586,20 @@ void ExecuteDraw(const Command& c) {
     g_draw->SetUploadAhead(UploadAhead);
     g_draw->SetTextureSizeConstants(g_profile->texture_size_constants, g_profile->texture_size_constant_count);
   }
+  // Profile::scene_resolve_before_output: the scene's copy is antialiased before it is drawn into the frame.
+  if (g_pending_scene_copy && g_aa.mode() != Antialiasing::Mode::kOff) {
+    const GuestSurface first = Tiled(c.surfaces[0] ? c.surfaces[0] : c.surfaces[4]);
+    if (first.width == g_profile->output_width && first.height == g_profile->output_height) {
+      if (ResolvedTexture* copy = g_resolved.FindNewest(g_pending_scene_copy, false)) {
+        if (ITextureView* view = copy->SliceView(0)) {
+          g_aa.Apply(g_device->context(), copy->texture, view);
+          g_scene_antialiased = true;
+          g_draw->TargetsChanged();
+        }
+      }
+      g_pending_scene_copy = 0;
+    }
+  }
   std::array<HostTarget*, 5> targets;
   HostTarget* first_target = nullptr;
   for (uint32_t i = 0; i < 5; ++i) targets[i] = TargetFor(Tiled(c.surfaces[i]), BindingOf(c));
@@ -595,9 +612,13 @@ void ExecuteDraw(const Command& c) {
   // its pipeline. Such passes may be drawn once and resolved: GH Metallica's post-processing mask, drawn at the
   // career's first song load, showed garbage for the session when its draw was skipped on a first run.
   // D126: a pass drawn frame after frame does not: skipped, it mends itself as soon as the pipeline is ready, and a
-  // pipeline can take the driver most of a second, which stopped the whole game.
-  const bool offscreen = first_target && (first_target->guest_width != g_profile->output_width ||
-                                          first_target->guest_height != g_profile->output_height);
+  // pipeline can take the driver most of a second, which stopped the whole game. A target of the profile's scene size
+  // counts as the output's (Profile::scene_width/height).
+  const bool offscreen =
+      first_target && !((first_target->guest_width == g_profile->output_width &&
+                         first_target->guest_height == g_profile->output_height) ||
+                        (g_profile->scene_width && first_target->guest_width == g_profile->scene_width &&
+                         first_target->guest_height == g_profile->scene_height));
   bool steady = false;
   if (offscreen) {
     if (first_target->drawn_frame != g_frames_presented) {
@@ -985,8 +1006,13 @@ void ExecuteResolve(const Command& c) {
   }
   // The copy of the finished scene (the profile's scene_resolve_caller): antialiased in place (D41).
   // It is of the game's output size (D65).
-  if (g_aa.mode() != Antialiasing::Mode::kOff && c.scene_caller && slice == 0 &&
-      target->guest_width == g_profile->output_width &&
+  if (g_profile->scene_resolve_before_output && c.scene_caller && slice == 0 && !surface.depth &&
+      g_profile->scene_width && target->guest_width == g_profile->scene_width &&
+      target->guest_height == g_profile->scene_height) {
+    g_pending_scene_copy = target->address;
+  }
+  if (!g_profile->scene_resolve_before_output && g_aa.mode() != Antialiasing::Mode::kOff && c.scene_caller &&
+      slice == 0 && target->guest_width == g_profile->output_width &&
       target->guest_height == g_profile->output_height &&
       !(g_profile->scene_resolve_once && g_scene_antialiased)) {
     g_aa.Apply(g_device->context(), target->texture, target_view);
-- 
